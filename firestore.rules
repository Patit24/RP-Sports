rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── USERS ──────────────────────────────────────────────────────────────
    // Public write/read for customer profiles and session management
    match /users/{userId} {
      allow read, write: if true;
    }

    // ── ORDERS ─────────────────────────────────────────────────────────────
    // Guest & Customer Checkout order creation, admin retrieval & status updates
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // ── PRODUCTS ───────────────────────────────────────────────────────────
    // Anyone can read store products; admins can manage store catalog
    match /products/{productId} {
      allow read, write: if true;
    }

    // ── WISHLISTS ──────────────────────────────────────────────────────────
    match /wishlists/{userId} {
      allow read, write: if true;
    }

    // ── CONTACTS (form submissions) ────────────────────────────────────────
    match /contacts/{docId} {
      allow read, write: if true;
    }

    // ── SUBSCRIBERS ────────────────────────────────────────────────────────
    match /subscribers/{email} {
      allow read, write: if true;
    }

    // ── ANALYTICS EVENTS ──────────────────────────────────────────────────
    match /analytics_events/{docId} {
      allow read, write: if true;
    }

    // ── FALLBACK ──────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
