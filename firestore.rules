rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is an authenticated administrator
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == 'admin_rpsports_com' || 
        request.auth.uid == 'catalog_rpsports_com' || 
        request.auth.uid == 'warehouse_rpsports_com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin']
      );
    }

    // ── USERS ──────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Anyone can read user profile summaries
      allow read: if true;
      // User can write their own profile, or admins can write
      allow write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }

    // ── ORDERS ─────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      // Admins can read all orders
      // Regular customers can read their own orders (where userEmail matches request.auth.token.email)
      // Anyone can read a single order (get) by docId to support guest lookup and status verification
      allow read: if isAdmin() || 
                  (request.auth != null && request.auth.token.email != null && resource.data.userEmail == request.auth.token.email) ||
                  (request.auth != null && request.auth.uid != null && resource.data.userEmail == request.auth.uid) ||
                  request.method == 'get';
      
      // Creating orders is allowed for everyone (to support guest checkout)
      allow create: if true;
      
      // Modifying/Deleting orders is restricted to administrators
      allow update, delete: if isAdmin();
    }

    // ── PRODUCTS ───────────────────────────────────────────────────────────
    match /products/{productId} {
      // Anyone can view products
      allow read: if true;
      // Only admins can write products
      allow write: if isAdmin();
    }

    // ── WISHLISTS ──────────────────────────────────────────────────────────
    match /wishlists/{userId} {
      // User owns their wishlist, or admin
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }

    // ── CONTACTS (form submissions) ────────────────────────────────────────
    match /contacts/{docId} {
      // Anyone can submit a contact form
      allow create: if true;
      // Only admins can read/list submissions
      allow read, update, delete: if isAdmin();
    }

    // ── SUBSCRIBERS ────────────────────────────────────────────────────────
    match /subscribers/{email} {
      // Anyone can subscribe
      allow create: if true;
      // Only admins can read subscribers
      allow read, update, delete: if isAdmin();
    }

    // ── ANALYTICS EVENTS ──────────────────────────────────────────────────
    match /analytics_events/{docId} {
      // Anyone can log events
      allow create: if true;
      // Only admins can read logs
      allow read, update, delete: if isAdmin();
    }

    // ── SETTINGS ──────────────────────────────────────────────────────────
    match /settings/{docId} {
      // Only admins can read and write store settings
      allow read, write: if isAdmin();
    }

    // ── FALLBACK ──────────────────────────────────────────────────────────
    match /{document=**} {
      // Fallback blocks non-admin updates
      allow read, write: if isAdmin();
    }
  }
}
