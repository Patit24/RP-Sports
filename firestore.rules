rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── USERS ──────────────────────────────────────────────────────────────
    // Only authenticated users can write to their own profile; allow simulated admins
    match /users/{userId} {
      allow read: if true;
      allow write: if (request.auth != null && request.auth.uid == userId)
                   || userId == 'admin_rpsports_com'
                   || userId == 'catalog_rpsports_com'
                   || userId == 'warehouse_rpsports_com';
    }

    // ── ORDERS ─────────────────────────────────────────────────────────────
    // Guest & Customer Checkout order creation, admin retrieval & status updates
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // ── PRODUCTS ───────────────────────────────────────────────────────────
    // Anyone can read store products; admins can manage store catalog
    match /products/{productId} {
      allow read, write: if true;
    }

    // ── WISHLISTS ──────────────────────────────────────────────────────────
    // Only authenticated users can manage their own wishlist
    match /wishlists/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── CONTACTS (form submissions) ────────────────────────────────────────
    match /contacts/{docId} {
      allow read, write: if true;
    }

    // ── SUBSCRIBERS ────────────────────────────────────────────────────────
    match /subscribers/{email} {
      allow read, write: if true;
    }

    // ── ANALYTICS EVENTS ──────────────────────────────────────────────────
    match /analytics_events/{docId} {
      allow read, write: if true;
    }

    // ── FALLBACK ──────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
