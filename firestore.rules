rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── USERS ──────────────────────────────────────────────────────────────
    // Users can read/write their own profile only
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Admins can read any user
      allow read: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // ── ORDERS ─────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      // Users can create orders and read their own orders
      allow create: if true; // allow guest checkout
      allow read: if request.auth != null && 
        (resource.data.userEmail == request.auth.token.email ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["admin", "super_admin"]);
      // Only admins can update order status
      allow update: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["admin", "super_admin"];
      allow delete: if false;
    }

    // ── PRODUCTS ───────────────────────────────────────────────────────────
    match /products/{productId} {
      // Anyone can read products (public catalogue)
      allow read: if true;
      // Only admins can write products
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["admin", "super_admin"];
    }

    // ── WISHLISTS ──────────────────────────────────────────────────────────
    match /wishlists/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── CONTACTS (form submissions) ────────────────────────────────────────
    match /contacts/{docId} {
      // Anyone can submit a contact form
      allow create: if true;
      // Only admins can read/delete submissions
      allow read, delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["admin", "super_admin"];
      allow update: if false;
    }

    // ── SUBSCRIBERS ────────────────────────────────────────────────────────
    match /subscribers/{email} {
      allow create: if true;
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["admin", "super_admin"];
      allow update, delete: if false;
    }

    // ── ANALYTICS EVENTS ──────────────────────────────────────────────────
    match /analytics_events/{docId} {
      allow create: if true;
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["admin", "super_admin"];
      allow update, delete: if false;
    }

    // ── DENY ALL OTHER ────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
