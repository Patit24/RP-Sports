# ==============================================================================
# RP SPORTS — PRODUCTION ENVIRONMENT VARIABLES (.env.local)
# ==============================================================================

# ── 1. SHIPROCKET LOGISTICS API CREDENTIALS ──
SHIPROCKET_EMAIL=YOUR_SHIPROCKET_EMAIL_HERE
SHIPROCKET_PASSWORD=YOUR_SHIPROCKET_PASSWORD_HERE
SHIPROCKET_PICKUP_LOCATION=Dumdum Store

# ── 2. FIREBASE CLIENT CONFIGURATION ──
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY_HERE
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_FIREBASE_AUTH_DOMAIN_HERE
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID_HERE
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_STORAGE_BUCKET_HERE
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID_HERE
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID_HERE
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=YOUR_FIREBASE_MEASUREMENT_ID_HERE

# ── 3. WEBSITE CONFIGURATION & DOMAIN ──
NEXT_PUBLIC_SITE_URL=https://YOUR_DOMAIN_HERE
NEXT_PUBLIC_STORE_NAME="RP Sports"
NEXT_PUBLIC_STORE_LOCATION="Dumdum, Kolkata"

# ── 4. APP URL (used by server-side OAuth callback) ──
# Local dev: http://localhost:3000  |  Production: https://YOUR_VERCEL_URL.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── 5. GOOGLE OAUTH 2.0 CREDENTIALS ──
# Get from: https://console.cloud.google.com → APIs & Services → Credentials → Create OAuth 2.0 Client ID
# Authorized redirect URIs must include: http://localhost:3000/api/auth/google/callback  AND  https://YOUR_VERCEL_URL/api/auth/google/callback
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE

# ── 6. FIREBASE ADMIN SDK CREDENTIALS ──
# Get from: Firebase Console → Project Settings → Service Accounts → Generate New Private Key
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID_HERE
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@YOUR_PROJECT_ID.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=YOUR_PRIVATE_KEY_HERE
